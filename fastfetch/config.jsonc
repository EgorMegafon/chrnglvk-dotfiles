{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "source": "~/.config/fastfetch/archovoe-ascii-art.txt",
    "type": "file",
    "color": {
      "1": "cyan",
      "2": "bold_white"
    }
  },

  "modules": [
    {
      "type": "title"
    },
    {
      "type": "custom",
      "format": "───────────"
    },
    {
      "type": "custom",
      "format": "┌ Software",
      "outputColor": "bright_yellow"
    },
    {
      "type": "os",
      "key": "│ OS",
      "keyColor": "bright_yellow"
    },
    {
      "type": "WM",
      "key": "│ WM",
      "keyColor": "bright_yellow"
    },
    {
      "type": "Packages",
      "key": "│ Packages",
      "keyColor": "bright_yellow"
    },
    {
      "type": "Uptime",
      "key": "│ Uptime",
      "keyColor": "bright_yellow"
    },
    {
      "type": "command",
      "key": "│ System Age",
      "text": "birth_install=$(stat -c %W /); current=$(date +%s); days_difference=$(( (current - birth_install) / 86400 )); echo $days_difference days",
      "keyColor": "bright_yellow"
    },
    {
      "type": "custom",
      "format": "└──────────",
      "outputColor": "bright_yellow"
    },
    {
      "type": "break"
    },
    {
      "type": "custom",
      "format": "┌ Hardware",
      "outputColor": "bright_green"
    },
    {
      "type": "CPU",
      "key": "│ CPU",
      "keyColor": "bright_green"
    },
    {
      "type": "GPU",
      "key": "│ GPU",
      "keyColor": "bright_green"
    },
    {
      "type": "Memory",
      "key": "│ RAM",
      "keyColor": "bright_green"
    },
    {
      "type": "Btrfs",
      "key": "│ Mem",
      "keyColor": "bright_green"
    },
    {
      "type": "LocalIP",
      "key": "│ Local IP",
      "keyColor": "bright_green"
    },
    {
      "type": "custom",
      "format": "└──────────",
      "outputColor": "bright_green"
    },
    {
      "type": "break"
    },
    {
      "type": "custom",
      "format": "〰〰〰〰〰〰〰〰〰〰〰〰〰〰〰〰〰〰〰〰〰〰〰〰〰〰〰〰〰〰〰",
      "outputColor": "bright_blue"
    },

    {
      "type": "custom",
      "format": " {#bright_red}><(((°>                             {#bright_magenta}<>< {#bright_yellow}<><",
    },
    {
      "type": "custom",
      "format": "                    {#dim_yellow}<><             {#bright_green}<>< ",
    },
    {
      "type": "custom",
      "format": "         {#bright_cyan}<°)))><                             {#dim_red}><(((°>",
    },
    {
      "type": "custom",
      "format": "",
    },

    {
      "type": "break"
    },
    {
      "type": "custom",
      "format": " © 2026 KSG Group. All rights reserved"
    },
    {
      "type": "break"
    },
  ]
}
