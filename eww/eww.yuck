(defvar icons '{
    "menu":             "\\ue5c3",
    "play":             "\\ue037",
    "pause":            "\\ue034",
    "previous":         "\\ue045",
    "next":             "\\ue044",
    "shuffle":          "\\ue043",
    "loop":             "\\ue040",
    "loop_one":         "\\ue041",
    "cpu":              "\\ue322",
    "ram":              "\\uf7a3",
    "gpu":              "\\uef5b",
    "volume_full":      "\\ue050",
    "volume_half":      "\\ue04d",
    "volume_mute":      "\\ue04e",
    "volume_off":       "\\ue04f",
    "note":             "\\ue405",
    "timer":            "\\ue425",
    "alarm":            "\\ue855",
    "mic":              "\\ue029",
    "mic_muted":        "\\ue02b",
    "output":           "\\uf4f2",
    "output_muted":     "\\uf4f3",
    "open_list":        "\\ue313",
    "bt_on":            "\\ue1a7",
    "bt_off":           "\\ue1a9",
    "ethernet":         "\\ue8be",
    "wifi_on":          "\\ue63e",
    "wifi_bad":         "\\uef1b",
    "wifi_off":         "\\ue648",
    "power_settings" :  "\\ue8c6",
    "shutdown":         "\\ue8ac",
    "reboot":           "\\ue863",
    "logout":           "\\ue9ba",
    "suspend":          "\\uef44",
    "charge":           "\\uec1c",
    "bt_search":        "\\ue1aa",
    "disconnect":       "\\uead0",
    "connect":          "\\ueacf",
    "close":            "\\ue5cd"
}')



(defwindow bar [screen] :class "bar"
                        :geometry (geometry 
                                        :x "0%"
                                        :y "0%"
                                        :width "100%"
                                        :height "20px"
                                        :anchor "top center")
                        :stacking "fg"
                        :exclusive true
                        :focusable "none"
                        :windowtype "toolbar"
                        :wm-ignore false
    (centerbox 
        (box    :halign "start" 
                :space-evenly false

                (multibutton)
                (keyboard)
        )
        (box    :halign "center"
                :space-evenly false
                
                (clock)
        )
        (box    :halign "end"
                :space-evenly false

                (all-stuff-listener :visible false)
                (media-widget :screen screen)
                (control-button :screen screen)
        )
    )
)

(defwindow deactivation-area :class "deactivation-area"
            :geometry (geometry :width "100%"
                                :height "100%")
            :stacking "fg"
            :exclusive false
            :focusable "none"
        (eventbox :onclick "setsid -f ~/.config/eww/scripts/menus-manager.sh close-menus")
)

(defvar reveal_media_menu false)
(defwindow media-menu [screen]
                :class "media-menu"
                :namespace "eww-menu"
                :screen screen
                :geometry (geometry     :anchor "top right"
                                        :x "40px"
                                        :y "0"
                                        :width "200px")
                :stacking "overlay"
                :exclusive false
                :focusable "none"
                
                                
                (revealer       :transition "slidedown"
                                :duration "300ms"
                                :reveal reveal_media_menu

                                (media-menu-content)
                )
)

(defvar reveal_channels_menu false)
(defwindow channels-menu [screen]
                :class "channels-menu"
                :namespace "eww-menu"
                :screen screen
                :geometry (geometry     :anchor "top right"
                                        :x "40px"
                                        :y "0"
                                        :width "200px")
                :stacking "overlay"
                :exclusive false
                :focusable "none"
                
                                
                (revealer       :transition "slidedown"
                                :duration "300ms"
                                :reveal reveal_channels_menu

                                (channels-menu-content)
                )         

)

(defvar reveal_control_menu true)
(defwindow control-menu [screen]
                :class "control-menu"
                :namespace "eww-menu"
                :screen screen
                :geometry (geometry     :anchor "top right"
                                        :x "5px"
                                        :y "0"
                                        :width "200px")
                :stacking "overlay"
                :exclusive false
                :focusable "ondemand"
                
                                
                (revealer       :transition "slidedown"
                                :duration "300ms"
                                :reveal reveal_control_menu

                                (control-menu-content)
                )   

)


(defwidget all-stuff-listener [] 
        (box    :visible false
                (label :text all_media)
                (label :text pipewire_data)
        )
        
)







; ======================== MONITOR ========================

(defvar reveal_resource_usage false)
(defwidget multibutton []
        (box    :class "bar-island multibutton"
                :space-evenly false
                :halign "center"
                (button :class "button multibutton"
                        :halign "center"
                        :onclick "eww update reveal_resource_usage=${!reveal_resource_usage}"
                        :onrightclick "niri msg action toggle-overview"
                        (label :text "${icons.menu}" :class "icon multibutton")
                )
                (revealer   
                                :reveal reveal_resource_usage
                                :transition "slideright"
                                :duration "400ms"
                                                               
                                (box    :class "resource-monitor"
                                        :halign "center"
                                        :space-evenly false
                                        :spacing 2
                                        (label  :class "widget-separator"
                                                :text "|"
                                        )
                                        (box    :class "resource-item"
                                                :orientation "h"
                                                :space-evenly false
                                                :halign "start"
                                                :spacing 4
                                                (label :text "${icons.ram}" :class "icon resource-info")
                                                (label  :class "resource-info-text"
                                                        :halign "start"
                                                        :xalign 0
                                                        :text "${resource_usage.ram}GB"
                                                )
                                        )
                                        (box    :class "resource-item"
                                                :orientation "h"
                                                :space-evenly false
                                                :halign "start"
                                                :spacing 2
                                                (label :text "${icons.gpu}" :class "icon resource-info")
                                                (label  :class "resource-info-text"
                                                        :halign "start"
                                                        :xalign 0
                                                        :text "${resource_usage.vram}GB"
                                                )
                                        )
                                        (box    :class "resource-item"
                                                :orientation "h"
                                                :space-evenly false
                                                :halign "start"
                                                :spacing 4
                                                (label :text "${icons.cpu}" :class "icon resource-info")
                                                (label  :class "resource-info-text"
                                                        :halign "start"
                                                        :xalign 0
                                                        :text "${resource_usage.cpu}%"
                                                )
                                        )
                                )

                )
        )
        
)

(deflisten resource_usage :initial '{"cpu": "0.0", "ram": "0.0", "vram": "0.0"}'
    "~/.config/eww/scripts/target/release/resource-watcher")






; ======================== LAYOUT ========================

(deflisten lang :initial "en"
    "~/.config/eww/scripts/target/release/layout-watcher")
(defwidget keyboard []
        (eventbox       :class "bar-island"
                        :onclick "niri msg action switch-layout next"
                        (label  :class "keyboard"
                                :halign "center"
                                :xalign 0.5
                                :text lang
                        )
        )
        
)





; ======================== CLOCK ========================

(defvar reveal_timer false)
(defwidget clock []
        (eventbox       :class "bar-island"
                        :halign "center"
                        :onclick "eww update reveal_timer=${!reveal_timer}"
                        :onscroll "~/.config/eww/scripts/vertical-scroll.sh {}"
                        :onrightclick "niri msg action toggle-overview"
                        (box    :class "clock"
                                :space-evenly false
                                :halign "center"
                                (label  :class "date"
                                        :text {formattime(EWW_TIME, "%a, %e %B")}
                                )
                                (label  :class "time"
                                        :halign "center"
                                        :xalign 0.5
                                        :text {formattime(EWW_TIME, "%H:%M")}
                                )
                                (revealer       :reveal reveal_timer
                                                :transition "slideright"
                                                :duration "300ms"
                                                
                                                (box    :class "timer"
                                                        :space-evenly false
                                                        (label  :class "widget-separator"
                                                                :text "|"
                                                        )
                                                        (label  :class "icon timer"
                                                                :text "${icons.timer}"
                                                        )
                                                        (label  :class "text timer"
                                                                :text "timer here"
                                                        )
                                                )
                                )
                        )
                        
        )
)






; ======================== MPRIS WIDGET ========================

(deflisten active_media :initial '{"title": "nothing...", "artists": "nobody...", "player": "Spotify", "status": "playing"}'
    "~/.config/eww/scripts/target/release/media-watcher")
(defwidget media-widget [screen]
        (box    :class "bar-island now-playing"
                :halign "end"
                :space-evenly false
                :spacing 18
                (box    :class "media-buttons widget"
                        :halign "start"
                        (box    
                                :valign "center"
                                :spacing 10
                                (button :class "media-button widget"
                                        :onclick "playerctl --player ${active_media.player} previous"
                                        {icons.previous}
                                )
                                (button :class "media-button widget"
                                        :onclick "playerctl --player ${active_media.player} play-pause"
                                        (label :text    "${active_media.status == 'playing' 
                                                        ? '${icons.pause}' 
                                                        : '${icons.play}'}")
                                )
                                (button :class "media-button widget"
                                        :onclick "playerctl --player ${active_media.player} next"
                                        {icons.next}
                                )
                        )
                )
                (eventbox       :halign "center"
                                :onscroll       "${reveal_channels_menu ? '~/.config/eww/scripts/default-sink-volume-control.sh {}'
                                                : '~/.config/eww/scripts/media-control.sh volume {} ${active_media.player}'}"
                                :onclick        "setsid -f ~/.config/eww/scripts/menus-manager.sh open-menu media-menu ${screen};
                                                echo ${!reveal_media_menu ? 'media_menu_opened' : 'media_menu_closed'} > /tmp/eww-animation-controller.fifo"
                                :onrightclick "setsid -f ~/.config/eww/scripts/menus-manager.sh open-menu channels-menu ${screen}"
                                :onmiddleclick "pkill -USR1 -f 'eww/scripts/target/release/media-watcher'"
                                
                                (box    :space-evenly false
                                        :spacing 4
                                        (label  :class "icon widget"
                                                :halign "end"
                                                :text "${icons.note}"   
                                        )
                                        (label  :class "media-title widget"
                                                :halign "center"
                                                :limit-width 17
                                                :justify "center"
                                                :xalign 0.5
                                                :yalign 0.5
                                                :text {strlength(active_media.title) < 17 ? "${active_media.title} - ${active_media.artists}" : "${active_media.title}"}
                                        )
                                )
                                
                )
    )
)







; ======================== MPRIS MENU ========================

(deflisten all_media :initial "[]"
    "~/.config/eww/scripts/target/release/media-menu")
(defvar soft_all_media_updates "{}")

(defwidget media-menu-content []
    (box    :orientation "v" 
            :space-evenly false
        
        (for player in {jq(all_media, "sort_by(.player != \"" + active_media.player + "\")" )}
            (box :class "media-slot"
                (active-card :player player :visible {player.player == active_media.player})
                (player-card :player player :visible {player.player != active_media.player})
            )
        )
    )
)


(defvar player_changing_volume "")
(defvar changed_volume_value 10)
(defvar volume_hover_sign "")

(defvar player_changing_progress "")
(defvar changed_progress_value 0)
(defvar progress_hover_sign "")

(defvar media_art_rotation 0)
(defwidget active-card [player visible]
    (box    :class "menu-area media-active"
            :orientation "h"
            :visible visible
            :space-evenly false
            (box    :class "vinyl-container"
                    :halign "start"

                    (overlay    :class "vinyl-container"
                        :halign "start"
                
                    (box    :class "vinyl-bg"
                            :valign "center"
                            :halign "center"
                    )
                    (transform  :transform-origin-x "50%"
                                :transform-origin-y "50%"
                                :rotate media_art_rotation
                                
                                (box    :class "card-art"
                                        :valign "center"
                                        :halign "center"
                                        :style "background-image: url('${player.art == '' ? EWW_CONFIG_DIR + '/default-art.jpg' : player.art}');"
                                )
                    )
                    (box    :class "vinyl-fg"
                            :valign "center"
                            :halign "center"
                    )
                )
            )            
            
                (box    :class "active-media-info"
                        :orientation "v"
                        :valign "center"
                        :space-evenly false
                        (box    :orientation "v"
                                :halign "start"
                                :valign "center"
                                :space-evenly false
                                :class "active-media-text"

                                        
                                (label      :class "media-artists active"
                                                :halign "start"
                                                :justify "left"
                                                :unindent true
                                                :text "${player.artists}"    
                                )
                                (label      :class "media-title active"     
                                                :halign "start"
                                                :xalign 0
                                                :justify "left"
                                                :wrap-mode "word"
                                                :unindent true
                                                :limit-width 20
                                                :lines 2
                                                :text "${player.title}"
                                )
                        )

                        (eventbox       :class "media-progress active"
                                        :onhover    "echo soft > /tmp/eww-media-menu.fifo;
                                                eww update \
                                                player_changing_progress='${player.player}' \
                                                changed_progress_value=${jq(soft_all_media_updates, '."' + player.player + '".progress? // 0') / 1000000} \
                                                progress_hover_sign=$(date +%s%N)"
                                        :onhoverlost    "setsid -f ~/.config/eww/scripts/media-menu-slider-release.sh progress"
                                        (scale  :class "scale media-progress-scale active"
                                                :value {player_changing_progress == player.player ? changed_progress_value : jq(soft_all_media_updates, ".\"" + player.player + "\".progress? // 0") / 1000000}
                                                :min 00
                                                :max {player.duration > 0 ? player.duration / 1000000 : 1}
                                                :active {player.can_progress}
                                                :onchange "~/.config/eww/scripts/media-control.sh seek {} ${player.player} ${player_changing_progress}"
                                        )
                        )
                        
                        (box    :class "active-card-controls"
                                :orientation "h"
                                :valign "end"
                                :halign "center"
                                :space-evenly false
                                (box    :class "media-buttons"
                                        :orientation "h"
                                        :spacing 8
                                        :space-evenly false

                                        (box    :class "buttons-group"
                                                :orientation "h"

                                                (button :class "media-button active ${player.can_previous ? '' : 'impossible'}"
                                                        :active {player.can_previous}
                                                        :onclick "playerctl --player ${player.player} previous"
                                                        {icons.previous}
                                                )
                                                (button :class "media-button active ${player.can_pause ? '' : 'impossible'}"
                                                        :active {player.can_pause}
                                                        :onclick "playerctl --player ${player.player} play-pause"
                                                        {player.playing ? "${icons.pause}" : "${icons.play}"}
                                                )
                                                (button :class "media-button active ${player.can_next ? '' : 'impossible'}"
                                                        :active {player.can_next}
                                                        :onclick "playerctl --player ${player.player} next"
                                                        {icons.next}
                                                )
                                        )
                                        (box    :class "buttons-group"
                                                :orientation "h"
                                                :space-evenly false

                                                (button :class "media-button active ${player.loop_status == 'none' ? 'off' : ''}"
                                                        :active {player.can_loop}
                                                        :onclick    "playerctl --player ${player.player} loop ${
                                                                        player.loop_status == 'none' ? 'Playlist' :
                                                                        player.loop_status == 'playlist' ? 'Track' : 'None'} &&
                                                                        echo hard > /tmp/eww-media-menu.fifo"
                                                        {player.loop_status == 'track'    ? '${icons.loop_one}' : '${icons.loop}'}
                                                )
                                                (button :class "media-button active ${player.shuffle ? '' : 'off'} ${player.can_shuffle ? '' : 'impossible'}" 
                                                        :active {player.can_shuffle}
                                                        :onclick    "playerctl --player ${player.player} shuffle Toggle;
                                                                        echo hard > /tmp/eww-media-menu.fifo"
                                                        {icons.shuffle}
                                                )
                                        )
                                        
                                )
                        )
                        (box    :class "volume-group active"
                                :orientation "h"
                                :halign "center"
                                :space-evenly false
                                (button :class "media-button active"
                                        :onclick "~/.config/eww/scripts/media-control.sh volume {0} ${player.player} force; echo soft > /tmp/eww-media-menu.fifo"
                                        {jq(soft_all_media_updates, ".\"" + player.player + "\".volume? // 0") > 0.6 ? icons.volume_full : 
                                        jq(soft_all_media_updates, ".\"" + player.player + "\".volume? // 0") > 0.2 ? icons.volume_half : icons.volume_mute}

                                )
                                (eventbox       :class "media-volume active"
                                                :onhover    "echo soft > /tmp/eww-media-menu.fifo;
                                                        eww update \
                                                        player_changing_volume='${player.player}' \
                                                        changed_volume_value=${jq(soft_all_media_updates, '."' + player.player + '".volume? // 0') * 20} \
                                                        volume_hover_sign=$(date +%s%N)"
                                                :onhoverlost    "setsid -f ~/.config/eww/scripts/media-menu-slider-release.sh volume"
                                                (scale  :class "scale media-volume-scale active"
                                                        :value {player_changing_volume == player.player ? changed_volume_value : jq(soft_all_media_updates, ".\"" + player.player + "\".volume? // 0") * 20}
                                                        :min 0
                                                        :max 20
                                                        :round-digits 0
                                                        :active {player.can_volume}
                                                        :onchange   "eww update changed_volume_value={};
                                                                        ~/.config/eww/scripts/media-control.sh volume $(({} * 5)) ${player.player} force"
                                                )
                                )
                        )
                    
            )
    )
)
(defwidget player-card [player visible]
    (box        :class "menu-area media-background" 
                :visible visible
                :space-evenly false
                (box    :orientation "h"
                        :space-evenly false
                        (box    :orientation "v"
                                :halign "start"
                                :valign "center"
                                :space-evenly false
                                :class "background-media-text"

                                        
                                (label  :class "media-artists background"
                                        :halign "start"
                                        :justify "left"
                                        :unindent true
                                        :text "${player.artists}"    
                                )
                                (label  :class "media-title background"     
                                        :halign "start"
                                        :xalign 0
                                        :justify "left"
                                        :wrap-mode "word"
                                        :unindent true
                                        :limit-width 20
                                        :lines 2
                                        :text "${player.title}"
                                )
                        )
                        (box    :orientation "v"
                                :class "background-media-info"
                                :valign "center"
                                :halign "end"
                                :space-evenly false
                                (eventbox       :class "media-progress background"
                                                :onhover    "echo soft > /tmp/eww-media-menu.fifo;
                                                        eww update \
                                                        player_changing_progress='${player.player}' \
                                                        changed_progress_value=${jq(soft_all_media_updates, '."' + player.player + '".progress? // 0') / 1000000} \
                                                        progress_hover_sign=$(date +%s%N)"
                                                :onhoverlost    "setsid -f ~/.config/eww/scripts/media-menu-slider-release.sh progress"
                                                (scale  :class "scale media-progress-scale background"
                                                
                                                        :value {player_changing_progress == player.player ? changed_progress_value : jq(soft_all_media_updates, ".\"" + player.player + "\".progress? // 0") / 1000000}
                                                        :min 00
                                                        :max {player.duration > 0 ? player.duration / 1000000 : 1}
                                                        :active {player.can_progress}
                                                        :onchange "~/.config/eww/scripts/media-control.sh seek {} ${player.player} ${player_changing_progress}"
                                                )
                                )
                                (box    :class "background-card-controls"
                                        :orientation "h"
                                        :valign "end"
                                        :halign "center"
                                        :space-evenly false
                                        (box    :class "media-buttons"
                                                :orientation "h"
                                                :halign "center"
                                                :spacing 8
                                                :space-evenly false

                                                (box    :class "volume-group background"
                                                        :orientation "h"
                                                        :halign "center"
                                                        :space-evenly false
                                                        (button :class "media-button background"
                                                                :onclick "~/.config/eww/scripts/media-control.sh volume {0} ${player.player} force; echo soft > /tmp/eww-media-menu.fifo"
                                                                {jq(soft_all_media_updates, ".\"" + player.player + "\".volume? // 0") > 0.6 ? icons.volume_full : 
                                                                jq(soft_all_media_updates, ".\"" + player.player + "\".volume? // 0") > 0.2 ? icons.volume_half : icons.volume_mute}

                                                        )
                                                        (eventbox       :class "media-volume background"
                                                                        :onhover    "echo soft > /tmp/eww-media-menu.fifo;
                                                                                eww update \
                                                                                player_changing_volume='${player.player}' \
                                                                                changed_volume_value=${jq(soft_all_media_updates, '."' + player.player + '".volume? // 0') * 20} \
                                                                                volume_hover_sign=$(date +%s%N)"
                                                                        :onhoverlost    "setsid -f ~/.config/eww/scripts/media-menu-slider-release.sh volume"
                                                                        (scale  :class "scale media-volume-scale background"
                                                                                :value {player_changing_volume == player.player ? changed_volume_value : jq(soft_all_media_updates, ".\"" + player.player + "\".volume? // 0") * 20}
                                                                                :min 0
                                                                                :max 20
                                                                                :round-digits 0
                                                                                :active {player.can_volume}
                                                                                :onchange   "eww update changed_volume_value={};
                                                                                                ~/.config/eww/scripts/media-control.sh volume $(({} * 5)) ${player.player} force"
                                                                        )
                                                        )
                                                )

                                                (box    :class "buttons-group"
                                                        :orientation "h"

                                                        (button :class "media-button background ${player.can_previous ? '' : 'impossible'}"
                                                                :active {player.can_previous}
                                                                :onclick "playerctl --player ${player.player} previous"
                                                                {icons.previous}
                                                        )
                                                        (button :class "media-button background ${player.can_pause ? '' : 'impossible'}"
                                                                :active {player.can_pause}
                                                                :onclick "playerctl --player ${player.player} play-pause"
                                                                {player.playing ? "${icons.pause}" : "${icons.play}"}
                                                        )
                                                        (button :class "media-button background ${player.can_next ? '' : 'impossible'}"
                                                                :active {player.can_next}
                                                                :onclick "playerctl --player ${player.player} next"
                                                                {icons.next}
                                                        )
                                                )
                                                (box    :class "buttons-group"
                                                        :orientation "h"
                                                        :space-evenly false

                                                        (button :class "media-button background ${player.loop_status == 'none' ? 'off' : ''}"
                                                                :active {player.can_loop}
                                                                :onclick    "playerctl --player ${player.player} loop ${
                                                                                player.loop_status == 'none' ? 'Playlist' :
                                                                                player.loop_status == 'playlist' ? 'Track' : 'None'} &&
                                                                                echo hard > /tmp/eww-media-menu.fifo"
                                                                {player.loop_status == 'track'    ? '${icons.loop_one}' : '${icons.loop}'}
                                                        )
                                                        (button :class "media-button background ${player.shuffle ? '' : 'off'} ${player.can_shuffle ? '' : 'impossible'}" 
                                                                :active {player.can_shuffle}
                                                                :onclick    "playerctl --player ${player.player} shuffle Toggle;
                                                                                echo hard > /tmp/eww-media-menu.fifo"
                                                                {icons.shuffle}
                                                        )
                                                )
                                                        
                                        )
                                )
                        )
                )
        )
)







; ======================== PIPEWIRE ========================

(defvar audio_streams "")
(defvar audio_inputs "")
(defvar audio_outputs "")
(deflisten pipewire_data :default "[]"
        "~/.config/eww/scripts/target/release/channels-menu")
(defwidget channels-menu-content []
        (box    :orientation "v" 
                :space-evenly false
                :class "transparent"

                (pipewire-outputs)
                (pipewire-inputs)
                (pipewire-streams)                
        )
)
(defvar reveal_inactive_outputs false)
(defvar media_outputs_reveal_button_rotation 0.0)
(defwidget pipewire-outputs []
       (box     :class "menu-area outputs"
                :orientation "v"
                :space-evenly false

                
                (box    :class "node-slot"
                        :halign "center"
                        :space-evenly false
                        (device-card :node {jq(audio_outputs, 'map(select(.default == true))[0]')} :type "output" :active true)
                        (eventbox
                                :halign "center"
                                :onclick 
                                        "eww update reveal_inactive_outputs=${!reveal_inactive_outputs} &
                                        echo ${!reveal_inactive_outputs ? 'open_media_outputs' : 'close_media_outputs'} > /tmp/eww-animation-controller.fifo"
                                (transform
                                        :transform-origin-x "50%"
                                        :transform-origin-y "50%"
                                        :rotate media_outputs_reveal_button_rotation

                                        (label  :class "icon open-devices"
                                                :valign "center"
                                                :halign "center"
                                                :text "${icons.open_list}"
                                        )
                                )
                                        
                        )
                )
                
                (revealer       :transition "slidedown"
                                :duration "300ms"
                                :reveal reveal_inactive_outputs

                        (box    :class "inactive-nodes"
                                :orientation "v"
                                :spacing 5

                                (for node in {jq(audio_outputs, 'map(select(.default == false))')}
                                        (device-card :node node :type "output" :active false)  
                                )
                        )
                                
                )
                
                
        ) 
)
(defvar reveal_inactive_inputs false)
(defvar media_inputs_reveal_button_rotation 0.0)
(defwidget pipewire-inputs []
        (box    :class "menu-area inputs"
                :orientation "v"
                :space-evenly false

                (box    :class "default-node"
                        :space-evenly false
                        :halign "center"

                        (device-card :node {jq(audio_inputs, 'map(select(.default == true))[0]')} :type "input" :active true)
                                (eventbox
                                        :halign "center"
                                        :onclick 
                                                "eww update reveal_inactive_inputs=${!reveal_inactive_inputs} &
                                                echo ${!reveal_inactive_inputs ? 'open_media_inputs' : 'close_media_inputs'} > /tmp/eww-animation-controller.fifo"
                                (transform
                                        :transform-origin-x "50%"
                                        :transform-origin-y "50%"
                                        :rotate media_inputs_reveal_button_rotation

                                        (label  :class "icon open-devices"
                                                :valign "center"
                                                :halign "center"
                                                :text "${icons.open_list}"
                                        )
                                )           
                        )
                )

                
                (revealer       :transition "slidedown"
                                :duration "300ms"
                                :reveal reveal_inactive_inputs

                        (box    :class "inactive-nodes"
                                :orientation "v"
                                :space-evenly false
                                :spacing 5

                                (for node in {jq(audio_inputs, 'map(select(.default == false))')}
                                        (device-card :node node :type "input" :active false)
                                )

                        )
                )
                
        )
)
(defwidget device-card [node type active]
        (box    :class "node-card"
                :orientation "v"
                :halign "center"
                :space-evenly false

                (eventbox
                        :onclick "~/.config/eww/scripts/device-volume-control.sh ${node.id} default"

                        (label  :class "device-name ${active ? 'default' : ''}"
                                :halign {active ? "start" : "center"}
                                :valign "center"
                                :xalign 0.5
                                :yalign 0.5
                                :text {node.name}
                        )
                )
                
                (box    :class "node-controls ${active ? 'default' : ''}"
                        :orientation "h"
                        :space-evenly false
                        :valign "center"
                        :halign "center"

                        (eventbox       :class "node-mute"
                                        :onclick "~/.config/eww/scripts/device-volume-control.sh ${node.id} mute"
                                        (box
                                                (label  :class "icon node-mute ${active ? 'default filled' : ''} ${pipewire_data[node.id].muted ? 'mute' : ''}"
                                                        :visible {type == "input"}
                                                        :text {pipewire_data[node.id].muted ? "${icons.mic_muted}" : "${icons.mic}"}
                                                )
                                                (label  :class "icon node-mute ${active ? 'default filled' : ''} ${pipewire_data[node.id].muted ? 'mute' : ''}"
                                                        :visible {type == "output"}
                                                        :text {pipewire_data[node.id].muted ? "${icons.output_muted}" : "${icons.output}"}
                                                )
                                        )
                                        
                        )
                        (scale  :class "scale node-volume-scale ${active ? 'default' : ''}"
                                :value {pipewire_data[node.id].volume * 20}
                                :min 0
                                :max 20
                                :round-digits 0
                                :onchange "~/.config/eww/scripts/device-volume-control.sh ${node.id} volume $(({} * 5))"
                                
                        )
                )
        )
)

(defwidget pipewire-streams []
        (box    :class "menu-area streams"
                :orientation "v"
                :spacing 5

                (for group in audio_streams
                        (box    :class "node-slot"
                                (stream-card :group group)
                        )
                )
        )
)
(defwidget stream-card [group]
        (box    :class "node-card"
                :orientation "h"
                :space-evenly false
                :halign "center"

                (label  :class "stream-name"
                        :halign "end"
                        :valign "center"
                        :xalign 1.0
                        :yalign 0.5
                        :limit-width 9
                        :text "${group.name}"
                )  
                (eventbox       :class "node-mute"
                                :onclick "~/.config/eww/scripts/app-volume-control.sh mute ${pipewire_data[group.ids[0]].muted ? 0 : 1} ${jq(group.ids, 'map(tostring) | join(" ")')}"
                                
                                (label  :class "icon filled node-mute default ${pipewire_data[group.ids[0]].muted ? 'mute' : '' }"
                                        :text {pipewire_data[group.ids[0]].muted ? "${icons.volume_off}" : "${icons.volume_full}"}
                                )
                                
                )
                (scale  :class "scale stream-volume-scale"
                        :value {pipewire_data[group.ids[0]].volume * 20}
                        :min 0
                        :max 20
                        :round-digits 0
                        :onchange "setsid -f ~/.config/eww/scripts/app-volume-control.sh volume $(({} * 5)) '${group.name}' ${jq(group.ids, 'map(tostring) | join(" ")')}"
                )
                
        )
)




; ======================== CONTROLS ========================

(defwidget control-button [screen]
        (eventbox       
                :class "bar-island"
                :onclick "setsid -f ~/.config/eww/scripts/menus-manager.sh open-menu control-menu ${screen}
                                eww update reveal_control_settings=false"
                :onscroll "~/.config/eww/scripts/default-sink-volume-control.sh {}"

                
                (label  :class "icon control-button"
                        :halign "center"
                        :xalign 0.5
                        :text "󰣇"
                )
                
        )
)

(deflisten control_control_buttons_info :initial '{"ping": "0ms", "uptime": "0m"}'
        "~/.config/eww/scripts/target/release/control-watcher")
(defvar reveal_control_settings true)
(defvar current_control_menu 1)
(defvar bt_on false)
(defwidget control-menu-content []
        (box    :space-evenly false
                :orientation "v"
                (label :visible false :text bt_devices)
                (box    :class "menu-area control-menu-area"
                        :space-evenly false
                        :orientation "h"
                        :halign "fill"
                        :spacing 8

                        (box    :class "buttons-group control-menu-buttons"
                                :space-evenly true
                                :halign "center"


                                (eventbox
                                        :onrightclick "eww update reveal_control_settings=${!(current_control_menu == 0 && reveal_control_settings)} current_control_menu=0;
                                                        ${bt_scanning ? 'echo toggle_scan > /tmp/eww-bluetooth-menu.fifo' : ''}"

                                        (label  :class "icon control-menu-button"
                                                :text "${icons.wifi_on}"
                                        )
                                )
                                (eventbox
                                        :onclick "eww update reveal_control_settings=${!(current_control_menu == 0 && reveal_control_settings)} current_control_menu=0;
                                                        ${bt_scanning ? 'echo toggle_scan > /tmp/eww-bluetooth-menu.fifo' : ''}"

                                        (label  :class "control-menu-button-info"
                                                :halign "center"
                                                :text "${control_control_buttons_info.ping}"
                                        )
                                )
                        )
                        (box    :class "buttons-group control-menu-buttons"
                                :space-evenly true
                                :halign "center"

                                (eventbox
                                        :onrightclick "eww update reveal_control_settings=${!(current_control_menu == 1 && reveal_control_settings)} current_control_menu=1"
                                        :onclick "echo toggle_bluetooth > /tmp/eww-bluetooth-menu.fifo"

                                        (label  :class "icon control-menu-button ${bt_on ? '' : 'inactive'}"
                                                :text {bt_on ? "${icons.bt_on}" : "${icons.bt_off}"}
                                        )
                                )
                                (eventbox
                                        :onclick "eww update reveal_control_settings=${!(current_control_menu == 1 && reveal_control_settings)} current_control_menu=1"

                                        (label  :class "control-menu-button-info"
                                                :halign "start"
                                                :text "${arraylength(bt_addresses_connected)} dv"
                                        )
                                )
                        )
                        (box    :class "buttons-group control-menu-buttons"
                                :space-evenly true
                                :halign "center"

                                (eventbox
                                        :onclick "eww update reveal_control_settings=${!(current_control_menu == 2 && reveal_control_settings)} current_control_menu=2;
                                                        ${bt_scanning ? 'echo toggle_scan > /tmp/eww-bluetooth-menu.fifo' : ''}"

                                        (label  :class "icon control-menu-button"
                                                :text "${icons.power_settings}"
                                        )
                                )
                                (eventbox
                                        :onclick "eww update reveal_control_settings=${!(current_control_menu == 2 && reveal_control_settings)} current_control_menu=2;
                                                        ${bt_scanning ? 'echo toggle_scan > /tmp/eww-bluetooth-menu.fifo' : ''}"

                                        (label  :class "control-menu-button-info"
                                                :halign "center"
                                                :text "${control_control_buttons_info.uptime}"
                                        )
                                )
                        )
                )

                (revealer
                        
                        :transition "slidedown"
                        :duration "300ms"
                        :reveal reveal_control_settings

                        (stack  
                                :selected current_control_menu
                                :transition "slidedown"

                                (wifi-menu)
                                (bt-menu)
                                (power-menu)
                        )
                )
                
                (box    :class "menu-area control-menu-area"
                        (wallpaper-menu)
                )
        )
)

(defwidget wifi-menu []
        (box    :class "menu-area control-menu-area"
                (label :text "wifi")
        )
        
)


(defvar bt_addresses_connected "[]")
(defvar bt_addresses_paired "[]")
(defvar bt_addresses_found "[]")

(deflisten bt_devices :default "{}"
        "~/.config/eww/scripts/target/release/bluetooth-menu")

(defvar bt_scanning false)
(defwidget bt-menu []
        (box    :class "menu-area control-menu-area"
                :orientation "v"
                :space-evenly false
                :spacing 16
                (revealer
                        :reveal {arraylength(bt_addresses_connected) > 0}
                        :transition "slidedown"
                        :duration "300ms"

                        (box 
                                :space-evenly false
                                :orientation "v"

                                (label  :class "bt-menu-title"
                                        :halign "start"
                                        :text "Connected:"
                                )
                                (for address in bt_addresses_connected
                                        (bt-device-connected :address address)
                                )

                        )
                )
                (box    :space-evenly false
                        :orientation "h"

                        (box    :space-evenly false
                                :orientation "v"

                                (label  :class "bt-menu-title"
                                        :halign "start"
                                        :text "Paired:"
                                )
                                (for address in bt_addresses_paired
                                        (bt-device-paired :address address)
                                )
                                (label  :class "bt-paired-nothing-here"
                                        :xalign "0.0"
                                        :visible {!(arraylength(bt_addresses_paired) > 0)}
                                        :text "nothing here..."
                                )
                        )
                        (eventbox
                                :hexpand true
                                :valign "end"
                                :halign "center"
                                :onclick "echo toggle_scan > /tmp/eww-bluetooth-menu.fifo"
                                
                                (label  :class "icon bt-menu-icon ${bt_scanning ? 'scanning' : ''}"
                                        :text {icons.bt_search}
                                )
                        )
                )
                
                (revealer
                        :reveal bt_scanning
                        :transition "slidedown"
                        :duration "300ms"

                        (box 
                                :space-evenly false
                                :orientation "v"

                                (label  :class "bt-menu-title"
                                        :halign "start"
                                        :text "Found:"
                                )
                                (for address in bt_addresses_found
                                        (bt-device-found :address address)
                                )
                                (label  :visible {!(arraylength(bt_addresses_found) > 0)}
                                        :xalign "0.0"
                                        :text "nothing here..."
                                )
                        )
                )
        )
)
(defwidget bt-device-connected [address]
        (box    :class "bt-device"
                :orientation "h"
                :space-evenly false

                (label  :class "bt-device-name"
                        :lines 2
                        :limit-width 15
                        :text "${bt_devices[address].name}"
                )
                (box    :hexpand true
                        :halign "center"
                        :space-evenly false
                        :spacing 12
                        (box
                                :orientation "h"
                                :space-evenly false

                                (label  :class "icon filled bt-device-charge"
                                        :text {icons.charge}
                                )
                                (label  :class "bt-device-charge"
                                        :text "${bt_devices[address].battery}%"
                                )
                        )
                        (box
                                (eventbox
                                        :onclick "echo disconnect ${address} > /tmp/eww-bluetooth-menu.fifo"

                                        (label  :class "icon bt-device-icon"
                                                :text {icons.disconnect}
                                        )
                                )
                                (eventbox
                                        :onclick "echo forget ${address} > /tmp/eww-bluetooth-menu.fifo"
                                        
                                        (label  :class "icon bt-device-icon"
                                                :text {icons.close}
                                        )
                                )
                        )
                        
                )
                
        )
)
(defwidget bt-device-paired [address]
        (box    :class "bt-device"
                :orientation "h"
                :space-evenly false

                (label  :class "bt-device-name"
                        :lines 2
                        :limit-width 15
                        :text "${bt_devices[address].name}"
                )
                (box    :hexpand true
                        :halign "center"
                        :space-evenly false
                        (eventbox
                                :onclick "echo connect ${address} > /tmp/eww-bluetooth-menu.fifo"

                                (label  :class "icon bt-device-icon"
                                        :text {icons.connect}
                                )
                        )
                        (eventbox
                                :onclick "echo forget ${address} > /tmp/eww-bluetooth-menu.fifo"
                                        
                                (label  :class "icon bt-device-icon"
                                        :text {icons.close}
                                )
                        )
                        
                )
                
        )
)
(defwidget bt-device-found [address]
        (box    :class "bt-device"
                :space-evenly false
                :orientation "v"
                
                (box    :orientation "h"
                        :space-evenly false

                        (box    
                                :space-evenly false

                                (label  :class "bt-device-name found"
                                        :limit-width 20
                                        :xalign 0.0
                                        :text "${bt_devices[address].name}"
                        )

                        )
                        
                        (box    :hexpand true
                                :halign "center"
                                :space-evenly false
                                (eventbox
                                        :onclick "echo pair ${address} > /tmp/eww-bluetooth-menu.fifo"

                                        (label  :class "icon bt-device-icon"
                                                :text {icons.connect}
                                        )
                                )
                        )
                )
                (revealer
                        :reveal  {bt_devices[address].status == "prompt"}
                        :transition "slidedown"
                        :duration "300ms"

                        (box    
                                :space-evenly false
                                :orientation "h"
                                
                                (label  :class "prompt-question"
                                        :visible {bt_devices[address].prompt.kind == "input"}
                                        :xalign 1.0
                                        :text "Enter PIN:"
                                )
                                (input  :class "prompt-input"
                                        :visible {bt_devices[address].prompt.kind == "input"}
                                        :onchange "~/.config/eww/scripts/bluetooth-pairing-manager.sh ${address} '{}'"
                                )

                                (label  :class "prompt-question"
                                        :visible {bt_devices[address].prompt.kind == "output"}
                                        :text "Copy PIN:"
                                )
                                (label  :class "prompt-output"
                                        :visible {bt_devices[address].prompt.kind == "output"}
                                        :text "${bt_devices[address].prompt.value}"
                                )
                                
                                (label  :class "prompt-question"
                                        :visible {bt_devices[address].prompt.kind == "confirm"}
                                        :text "Confirm:"
                                )
                                (box    :class "prompt-confirm"
                                        :visible {bt_devices[address].prompt.kind == "confirm"}
                                        :space-evenly false
                                        :hexpand true
                                        :spacing 32
                                        :halign "center"

                                        (eventbox
                                                :onclick "echo answer ${address} yes > /tmp/eww-bluetooth-menu.fifo"

                                                (label
                                                        :text "yep"
                                                )
                                        )
                                        (eventbox
                                                :onclick "echo answer ${address} no > /tmp/eww-bluetooth-menu.fifo"

                                                (label
                                                        :text "nah"
                                                )
                                        )
                                )
                        )
                        
                )
        )
)


(defwidget power-menu []
        (box    :class "menu-area"
                :orientation "h"
                (eventbox
                        :class "icon power-menu"
                        :onclick "systemctl poweroff"
                        (label :text {icons.shutdown})
                )
                (eventbox
                        :class "icon power-menu"
                        :onclick "systemctl reboot"
                        (label :text {icons.reboot})
                )
                (eventbox
                        :class "icon power-menu"
                        :onclick "systemctl suspend"
                        (label :text {icons.suspend})
                )
                (eventbox
                        :class "icon power-menu"
                        :onclick "niri msg action quit -s"
                        (label :text {icons.logout})
                )
        )
)


(defwidget wallpaper-menu []
        (box
        
        )
)