(defwidget all-stuff-listener [] 
        (box    :visible false
                (label :text all_media)
                (label :text pipewire_data)
                (label :text wallpapers)
        )
        
)







; ======================== MONITOR ========================

(defvar reveal_resource_usage false)
(defwidget multibutton []
        (box    :class "bar-island multibutton"
                :space-evenly false
                :halign "center"
                (button :class "button multibutton"
                        :halign "center"
                        :onclick "eww update reveal_resource_usage=${!reveal_resource_usage}"
                        :onrightclick "niri msg action toggle-overview"
                        (label :text "${icons.menu}" :class "icon multibutton")
                )
                (revealer   
                                :reveal reveal_resource_usage
                                :transition "slideright"
                                :duration "400ms"
                                                               
                                (box    :class "resource-monitor"
                                        :halign "center"
                                        :space-evenly false
                                        :spacing 2
                                        (label  :class "widget-separator"
                                                :text "|"
                                        )
                                        (box    :class "resource-item"
                                                :orientation "h"
                                                :space-evenly false
                                                :halign "start"
                                                :spacing 4
                                                (label :text "${icons.ram}" :class "icon resource-info")
                                                (label  :class "resource-info-text"
                                                        :halign "start"
                                                        :xalign 0
                                                        :text "${resource_usage.ram}GB"
                                                )
                                        )
                                        (box    :class "resource-item"
                                                :orientation "h"
                                                :space-evenly false
                                                :halign "start"
                                                :spacing 2
                                                (label :text "${icons.gpu}" :class "icon resource-info")
                                                (label  :class "resource-info-text"
                                                        :halign "start"
                                                        :xalign 0
                                                        :text "${resource_usage.vram}GB"
                                                )
                                        )
                                        (box    :class "resource-item"
                                                :orientation "h"
                                                :space-evenly false
                                                :halign "start"
                                                :spacing 4
                                                (label :text "${icons.cpu}" :class "icon resource-info")
                                                (label  :class "resource-info-text"
                                                        :halign "start"
                                                        :xalign 0
                                                        :text "${resource_usage.cpu}%"
                                                )
                                        )
                                )

                )
        )
        
)

(deflisten resource_usage :initial '{"cpu": "0.0", "ram": "0.0", "vram": "0.0"}'
    "~/.config/eww/scripts/target/release/resource-watcher")






; ======================== KEYBOARD ========================

(deflisten lang :initial "en"
    "~/.config/eww/scripts/target/release/layout-watcher")
(defwidget keyboard []
        (eventbox       :class "bar-island"
                        :onclick "niri msg action switch-layout next"
                        (label  :class "keyboard"
                                :halign "center"
                                :xalign 0.5
                                :text lang
                        )
        )
        
)





; ======================== CLOCK ========================

(defvar reveal_timer false)
(defwidget clock [screen]
        (eventbox       :class "bar-island"
                        :halign "center"
                        :onclick "setsid -f ~/.config/eww/scripts/menus-manager.sh open-menu time-menu ${screen}"
                        :onscroll "~/.config/eww/scripts/vertical-scroll.sh {}"
                        :onrightclick "niri msg action toggle-overview"
                        (box    :class "clock"
                                :space-evenly false
                                :halign "center"
                                (label  :class "date"
                                        :text {formattime(EWW_TIME, "%a, %e %B")}
                                )
                                (label  :class "time"
                                        :halign "center"
                                        :xalign 0.5
                                        :text {formattime(EWW_TIME, "%H:%M")}
                                )
                                (revealer       :reveal reveal_timer
                                                :transition "slideright"
                                                :duration "300ms"
                                                
                                                (box    :class "timer"
                                                        :space-evenly false
                                                        (label  :class "widget-separator"
                                                                :text "|"
                                                        )
                                                        (label  :class "icon timer"
                                                                :text "${icons.timer}"
                                                        )
                                                        (label  :class "text timer"
                                                                :text "timer here"
                                                        )
                                                )
                                )
                        )
                        
        )
)
